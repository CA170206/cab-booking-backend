# Server Port
PORT=5000

# Database Connection (Option 1: Full Connection String - Recommended for Render, Supabase, Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Database Connection (Option 2: Individual Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ridego
DB_USER=postgres
DB_PASSWORD=your_database_password
# Optional SSL override: 'true' (force SSL), 'false' (disable SSL). Auto-detected if omitted.
DB_SSL=false

# Authentication Secret (Required - 64+ char random hex string)
JWT_SECRET=your_long_random_jwt_secret_key_here

# Payment Gateway (Razorpay - Optional for card/netbanking payments)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_placeholder
